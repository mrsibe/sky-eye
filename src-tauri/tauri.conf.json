{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sky Eye",
  "version": "0.2.4",
  "identifier": "com.mrsibe.sky-eye",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sky Eye",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IEYwNjEyQ0Q5MTM1QzI5NjQKUldSa0tWd1QyU3hoOE1hZmFpSS9uc2hGK0FrNE5UR2JTdjRpQWFaRUVGd1UyWkpwT1JFN2ZXL0wK",
      "endpoints": ["https://github.com/MrSibe/sky-eye/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
